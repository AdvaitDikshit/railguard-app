# Copy this file to api/.env and fill in real values.
# .env itself is gitignored — never commit real secrets.

# Postgres connection (matches docker-compose.yml defaults below)
DATABASE_URL=postgresql+psycopg2://railguard:railguard@localhost:5432/railguard

# Comma-separated list of allowed frontend origins — never "*" in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload limits
MAX_UPLOAD_MB=15
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.tif,.tiff,.webp

# Rate limits (slowapi / "limits" library syntax: "<count>/<period>")
RATE_LIMIT_DETECT=10/minute
RATE_LIMIT_REPORT=6/minute
RATE_LIMIT_PDF=20/minute

# Detection
CONF_THRESHOLD=0.55
MODEL_PATH=

# Optional — only needed if you also want the existing Claude
# AI-analysis feature (ai_analysis.py) available through this service later.
ANTHROPIC_API_KEY=

# Admin token — required to call POST /api/reports/{id}/verify.
# Generate one yourself, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty here on purpose — an unset token means /verify fails CLOSED
# (503), not open. Never commit the real value.
ADMIN_TOKEN=
